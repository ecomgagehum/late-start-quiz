# NEVER set ANTHROPIC_LOG, DEBUG, or any other debug logging variable in Vercel.
# Debug logging can write his quiz answers into the logs, which breaks the privacy promise.
#
# Copy this list into Vercel: Project > Settings > Environment Variables.
# Never paste real keys into chat or commit them to GitHub.

# ---------- AI ----------
# Required for real results. Make a NEW key just for the quiz at console.anthropic.com,
# and set a monthly spend limit there (start at $20).
ANTHROPIC_API_KEY=

# Optional. The Claude model that writes results. Default: claude-sonnet-5-5 (v2: deeper read, about 20 to 45 seconds).
# To save cost, try claude-haiku-5-5 (faster, but the read gets shallower).
QUIZ_MODEL=

# Optional. 1 = test mode. Shows a made-up sample result and never calls the AI. Leave empty when live.
QUIZ_MOCK=

# ---------- Email to Kajabi ----------
# How the email reaches Kajabi: off | form | webhook | api   (default: off)
#   off     = results work, email goes nowhere (testing only)
#   form    = post to your Kajabi opt-in form like a visitor (free on Basic). Must be tested live first.
#   webhook = send name, email and tag to a Zapier "Catch Hook" URL (Zapier costs monthly)
#   api     = Kajabi Public API (needs API access: Pro plan or the API add-on)
KAJABI_MODE=off

# Your Kajabi site address and form. Defaults shown.
KAJABI_SITE_ORIGIN=https://start.confidenceofayes.com
KAJABI_FORM_ID=2149754352
KAJABI_SITE_ID=2148936666

# form mode only, optional: one Kajabi form per type, each with an "add tag" automation in Kajabi.
# Example: {"freezer":"111","no_places":"222","burned_before":"333","never_started":"444"}
KAJABI_TYPE_FORM_IDS=

# webhook mode only
KAJABI_WEBHOOK_URL=
# Optional shared secret, sent as the X-Quiz-Secret header so Zapier can check it.
KAJABI_WEBHOOK_SECRET=

# api mode only (Kajabi Admin > User API Keys)
KAJABI_CLIENT_ID=
KAJABI_CLIENT_SECRET=
# Or, instead of the two above: a ready-made Bearer token, if Kajabi gives you one.
KAJABI_API_KEY=
# Kajabi tag IDs (numbers, not names) for each type. Example:
# {"freezer":"111","no_places":"222","burned_before":"333","never_started":"444"}
KAJABI_TAG_IDS=

# ---------- Safety limits ----------
# Quizzes per person (IP) per hour. Default 12 (phone carriers put many people on one IP).
RATE_LIMIT_PER_HOUR=
# Quizzes per day for everyone together. Default 300.
DAILY_LIMIT=
# Extra sites allowed to call the quiz API, comma separated. The quiz's own address is always allowed.
# Example: quiz.confidenceofayes.com
ALLOWED_ORIGINS=
